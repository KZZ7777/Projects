<%- include("partials/header") %>
    <div class="starting-container">
        <h1>To do list </h1>
        <div class="date-container">
            <p>Today</p>
            <p id="today-date"></p>
        </div>
    </div>

    <main>
        <div class="todo-container">
            <div class="todo-box">
                <form class="add" action="/add" method="post">
                    <input type="text" name="text" id="task" required placeholder="Add your tasks" />
                    <button id="btn" type="submit">Add</button>
                    <button id="clear-btn" type="submit" formaction="/clear" formmethod="post">Clear all</button>
                    <ul id="list">
                        <p>Er zijn geen taken</p>
                    </ul>
            </div>
        </div>
    </main>

    <%- include("partials/footer") %>