<%- include("partials/header") %>

    <main>
        <h1 class="todo-list">To do list <img src="/assets/images/images.png" alt="to do lijst"></h1>

        <form class="add" action="/add" method="post">
            <input type="text" name="text" id="task" required placeholder="Type in your task" />
            <button id="btn" type="submit">Add Task</button>
            <button id="clear-btn" type="submit" formaction="/clear" formmethod="post">Clear</button>


            <ul id="list">
                <% if (!todos || todos.length===0) { %>
                    <li>Er zijn geen taken  </li>
                    <% } %>
                        <% todos.forEach(t=> { %>
                            <li>
                                <span class="<%= t.done ? 'done' : '' %>">
                                    <%= t.text %>
                                </span>
                                <div class="actions">
                                    <form action="/toggle" method="post">
                                        <input type="hidden" name="id" value="<%= t.id %>">
                                        <button type="submit">
                                            <%= t.done ? 'Markeer open' : 'Markeer klaar' %>
                                        </button>
                                    </form>
                                    <form action="/delete" method="post" onsubmit="return confirm('Verwijderen?')">
                                        <input type="hidden" name="id" value="<%= t.id %>">
                                        <button type="submit">Verwijder</button>
                                    </form>
                                </div>
                            </li>
                            <% }) %>
            </ul>
    </main>

    <%- include("partials/footer") %>